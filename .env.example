# Copy to .env to override. Every value has a working default; nothing here is
# required to run the project.

# TRADETRACK_DB_PATH=data/trades.db

# Pagination
# TRADETRACK_API_PAGE_SIZE_DEFAULT=100
# TRADETRACK_API_PAGE_SIZE_MAX=1000

# Anomaly thresholds. quantity_mad_threshold=3.5 was selected by an F1 sweep
# and validated on held-out seeds - see benchmarks/detector_eval.md before
# changing it.
# TRADETRACK_LATENCY_P99_FLOOR_MS=250
# TRADETRACK_FAILURE_RATE_MIN_SAMPLES=50
# TRADETRACK_FAILURE_RATE_SIGMA=3.0
# TRADETRACK_QUANTITY_MAD_THRESHOLD=3.5

# Signal engine
# TRADETRACK_SIGNAL_WINDOW=200

# Dashboard -> API
# TRADETRACK_API_URL=http://127.0.0.1:8000

# Agentic triage layer. Without a key the scripted rule-based backend is used,
# so the graph, tools and tests all still run - only the model calls are skipped.
# Get a free key at https://console.groq.com/keys
# GROQ_API_KEY=
